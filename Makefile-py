SHELL       := bash
VENV        := .venv
PIP_MIN     := 26.3
CERTIFI_MIN := 2026.10.19

.PHONY: venv-prepare venv-init venv-clean venv-bash pip-install-tools pip-install pip-compile pip-audit pip-freeze pip-check-version

venv-prepare: venv-clean venv-init pip-install-tools pip-check-version pip-install
	@true

venv-init:
	python3 -m venv $(VENV)

venv-clean:
	rm -rfv $(VENV)

venv-bash:
	bash --rcfile <(echo "source $(VENV)/bin/activate") -i

pip-install-tools:
	source $(VENV)/bin/activate && pip install --upgrade "pip>=$(PIP_MIN)"
	source $(VENV)/bin/activate && pip install --upgrade pip-tools pip-audit "certifi>=$(CERTIFI_MIN)"

pip-install:
	source $(VENV)/bin/activate && yes | pip uninstall qwen-tts
	source $(VENV)/bin/activate && pip install -r requirements.txt --require-hashes
	source $(VENV)/bin/activate && pip install --no-deps qwen-tts==0.1.1
	source $(VENV)/bin/activate && pip install -e .

pip-compile: pip-check-version
	source $(VENV)/bin/activate && pip-compile --generate-hashes requirements.in --output-file=requirements.txt

pip-audit: pip-check-version
	source $(VENV)/bin/activate && pip-audit

pip-freeze: pip-check-version
	source $(VENV)/bin/activate && pip freeze

pip-check-version:
	source $(VENV)/bin/activate && python -c "import sys, pip; \
	from pip._vendor import certifi as vc; \
	from pip._vendor.packaging.version import Version as V; \
	print('pip', pip.__version__, '| certifi in pip', vc.__version__); \
	sys.exit(0 if V(pip.__version__) >= V('$(PIP_MIN)') and V(vc.__version__) >= V('$(CERTIFI_MIN)') else 1)"
